APP_ENV=development
APP_PORT=4000

# PostgreSQL (prisma/schema.prisma provider = "postgresql").
# URL-encode special characters in the password (e.g. @ -> %40).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing_app
DB_USER=postgres
DB_PASSWORD=

DATABASE_URL="postgresql://postgres:password@localhost:5432/billing_app"

JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=8h

INVOICE_PREFIX=INV-
COMPANY_NAME=My Company Pvt Ltd
COMPANY_GST_NUMBER=
COMPANY_ADDRESS=

CORS_ORIGIN=http://localhost:5173
