APP_ENV=development
APP_PORT=4000

# Quick local sample: SQLite, zero setup, just a file on disk.
# For MySQL later, set provider="mysql" in prisma/schema.prisma and use:
#   DATABASE_URL="mysql://root:password@localhost:3306/billing_app"
#   (docker-compose.yml in the repo root spins up that MySQL server)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=billing_app
DB_USER=root
DB_PASSWORD=

DATABASE_URL="file:./dev.db"

JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=8h

INVOICE_PREFIX=INV-
COMPANY_NAME=My Company Pvt Ltd
COMPANY_GST_NUMBER=
COMPANY_ADDRESS=

CORS_ORIGIN=http://localhost:5173
